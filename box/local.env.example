# Copy to box/local.env (git-ignored) and adjust. KEY=value, plain paths only (no quotes, no spaces).
# Where the box keeps its working data (downloads, logs, heartbeat). Default: ~/vice-cartel/box_fetch
VICE_DATA_DIR=/home/YOUR_USER/vice-cartel/box_fetch
# gh login to use (leave out to use gh's default login)
# GH_CONFIG_DIR=/home/YOUR_USER/.config/gh
# private key for the IG token handoff (see HANDOFF.md "IG token"); default ~/.config/vice-cartel/ig_handoff_rsa.pem
# VICE_IG_HANDOFF_KEY=/home/YOUR_USER/.config/vice-cartel/ig_handoff_rsa.pem
# yt-dlp: browser profile with a YouTube login (cookies are read from the browser, never copied into git)
# VICE_YT_COOKIES_BROWSER=chrome:/home/YOUR_USER/.config/google-chrome/Default
# yt-dlp JS runtime for YouTube's challenge, e.g. deno:/home/YOUR_USER/.deno/bin/deno
# VICE_YTDLP_JS_RUNTIME=deno:/home/YOUR_USER/.deno/bin/deno
# BOX_FETCH_MIN_FREE_GB=10
